# Toolchain image used by every `make` target: Go + Node, nothing on the host.
FROM golang:1.25-bookworm

ARG NODE_MAJOR=22
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git gnupg make bash unzip jq \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Writable caches for an arbitrary (host) UID.
RUN mkdir -p /.cache /go/pkg/mod /.npm && chmod -R 777 /.cache /go /.npm
ENV GOTOOLCHAIN=auto \
    GOFLAGS=-buildvcs=false \
    npm_config_cache=/.npm
WORKDIR /src
