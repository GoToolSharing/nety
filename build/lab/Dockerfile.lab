# Lab image: builds NETY from source and runs it with a shell available, so a
# failing experiment can be inspected from inside the container.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X github.com/vaadata/nety/internal/config.Version=lab" \
      -o /out/nety ./cmd/nety

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates iproute2 iputils-ping curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/nety /usr/local/bin/nety
VOLUME ["/data"]
EXPOSE 8443
ENTRYPOINT ["nety"]
CMD ["serve"]
