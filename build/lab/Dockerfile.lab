# Lab image: runs the binary `make build` already produced, so the lab tests
# exactly the artefact that ships, and brings a few network tools along so a
# failing experiment can be inspected from inside the container.
FROM debian:bookworm-slim
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates iproute2 iputils-ping curl tcpdump \
 && rm -rf /var/lib/apt/lists/*
COPY dist/nety-linux-${TARGETARCH} /usr/local/bin/nety
VOLUME ["/data"]
EXPOSE 8443
ENTRYPOINT ["nety"]
CMD ["serve"]
